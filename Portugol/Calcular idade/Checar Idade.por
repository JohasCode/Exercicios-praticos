programa {
  funcao inicio() 
  {
    inteiro idade

    // Solicita a idade
    escreva("Digite a sua idade: ")
    leia(idade)

    // Exibe se é maior ou menor de idade
    se (idade >= 18)
    {
      escreva("\nVocê é maior de idade")
    }
    senao
    {
      escreva("\nVocê é menor de idade")
    }
  }
}
